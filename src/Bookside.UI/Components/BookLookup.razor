@* Search box for book metadata (ISBN, or title and/or author); picking a
   result raises OnPick. Not a <form>, so it can sit next to the book's
   EditForm. *@
@inject IBookMetadataService Metadata

<section class="book-lookup card" aria-labelledby="lookup-heading">
    <h2 id="lookup-heading" class="lookup-heading">Look up</h2>
    <div class="lookup-row">
        <label for="lookup-query" class="visually-hidden">ISBN, title or author</label>
        <input id="lookup-query"
               type="search"
               @bind="_query"
               @bind:event="oninput"
               @onkeydown="OnKeyDown"
               placeholder="ISBN, title or author"
               autocomplete="off"
               enterkeyhint="search" />
        <button type="button" class="btn" disabled="@_searching" @onclick="SearchAsync">
            @(_searching ? "Searching…" : "Look up")
        </button>
    </div>
    <ErrorAlert Messages="_errors" />

    @if (_picked is not null)
    {
        <p class="alert alert-success" role="status">
            Filled the empty fields from @SourceName(_picked.Source)@CoverNote.
            Check them before saving.
        </p>
    }
    else if (_results is { Count: 0 })
    {
        <p class="muted" role="status">
            Nothing found. Try fewer words, or the ISBN on the back of the book.
        </p>
    }
    else if (_results is not null)
    {
        <ul class="lookup-results" aria-label="Results from @SourceName(_results[0].Source)">
            @foreach (var result in _results)
            {
                <li>
                    <button type="button" @onclick="() => PickAsync(result)">
                        <span class="thumb">
                            @if (result.CoverImageUrl is { } cover)
                            {
                                <img src="@cover"
                                     alt=""
                                     loading="lazy"
                                     decoding="async"
                                     referrerpolicy="no-referrer" />
                            }
                        </span>
                        <span class="text">
                            <span class="result-title">@result.Title</span>
                            <span class="muted">@Byline(result)</span>
                        </span>
                    </button>
                </li>
            }
        </ul>
        <p class="muted source">Results from @SourceName(_results[0].Source).</p>
    }
</section>

@code {
    private string _query = "";
    private bool _searching;
    private IReadOnlyList<BookMetadata>? _results;
    private BookMetadata? _picked;
    private IReadOnlyList<string> _errors = [];

    [Parameter, EditorRequired]
    public EventCallback<BookMetadata> OnPick { get; set; }

    private string CoverNote =>
        _picked?.CoverImageUrl is null ? "" : "; the cover is added when you save";

    private static string Byline(BookMetadata book) =>
        string.Join(", ", book.Authors)
        + (book.PublishedYear is { } year ? $" · {year}" : "");

    private static string SourceName(string source) => source switch
    {
        "openlibrary" => "Open Library",
        "googlebooks" => "Google Books",
        _ => source,
    };

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        if (_searching || string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        _searching = true;
        _errors = [];
        _picked = null;
        try
        {
            var result = await Metadata.SearchAsync(_query);
            _results = result.IsSuccess ? result.Value : null;
            _errors = result.IsSuccess ? [] : [ErrorMessage(result.Error)];
        }
        finally
        {
            _searching = false;
        }
    }

    private static string ErrorMessage(ServiceError error) =>
        error.Type == ErrorType.Unavailable
            ? "Book search is unavailable right now. Try again later."
            : error.Message;

    private async Task PickAsync(BookMetadata book)
    {
        _picked = book;
        _results = null;
        await OnPick.InvokeAsync(book);
    }
}
