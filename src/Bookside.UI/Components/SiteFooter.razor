@inject AppInfo App
@inject TimeProvider Clock

<footer class="site-footer">
    <p>
        <span>© @AppInfo.CopyrightYears(Clock.GetLocalNow().Year)</span>
        <span class="company">@AppInfo.Company</span>
        <span aria-hidden="true">·</span>
        <a href="@AppInfo.RepositoryUrl"
           target="_blank"
           rel="noopener">Bookside</a>&#32;
        @if (App.ReleaseUrl is { } releaseUrl)
        {
            <a class="version"
               href="@releaseUrl"
               target="_blank"
               rel="noopener">v@(App.Version)</a>
        }
        else
        {
            <span class="version">dev</span>
        }
    </p>
</footer>
