@* A one-off confetti burst with a message that pops up and fades. CSS only;
   the parent needs position: relative. *@

<div class="celebration">
    <div class="burst" aria-hidden="true">
        @foreach (var piece in Pieces)
        {
            <span class="confetti" style="@piece"></span>
        }
    </div>
    <span class="cheer" role="status">@Message</span>
</div>

@code {
    private const int PieceCount = 100;

    // canvas-confetti's default colours.
    private static readonly string[] Colors =
    [
        "#26ccff", "#a25afd", "#ff5e7e", "#88ff5a", "#fcff42", "#ffa62d", "#ff36ff",
    ];

    // Fixed pseudo-random spread, so every burst looks the same and renders
    // identically in tests.
    private static readonly string[] Pieces =
    [
        .. Enumerable.Range(0, PieceCount).Select(i =>
        {
            // 0..1, from a cheap integer hash of the piece and a salt.
            double R(int salt)
            {
                var h = unchecked((uint)(i * 374761393 + salt * 668265263));
                h = unchecked((h ^ (h >> 13)) * 1274126177);
                return (h ^ (h >> 16)) / (double)uint.MaxValue;
            }

            // Straight up, give or take 50° (a 100° cone); speed varies 1–3.3×.
            var angle = (90 + (R(1) * 2 - 1) * 50) * Math.PI / 180;
            var distance = 15 + R(2) * 35;
            return string.Create(
                CultureInfo.InvariantCulture,
                $"--x: {Math.Cos(angle) * distance:0.#}; " +
                $"--y: {-Math.Sin(angle) * distance:0.#}vh; " +
                $"--spin: {1.15 + R(3) * 0.6:0.00}s; " +
                $"--axis: {R(4):0.00} 1 {R(5):0.00}; " +
                $"--c: {Colors[i % Colors.Length]};");
        }),
    ];

    [Parameter]
    public string Message { get; set; } = "Goal reached!";
}
